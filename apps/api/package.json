{
  "name": "@byke-os/api",
  "version": "0.1.0",
  "private": true,
  "description": "Byke OS REST API (Node.js + Express + MongoDB)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:status": "npm run migrate -- executed && npm run migrate -- pending",
    "migrate:create": "npm run migrate -- create --folder src/db/migrations --name",
    "migrate:prod": "node dist/db/migrate.js up",
    "seed": "tsx --env-file=.env src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@byke-os/shared": "*",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.0",
    "multer": "^2.5.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.0.0"
  }
}
