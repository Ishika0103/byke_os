NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/byke_os
CORS_ORIGINS=http://localhost:8081
LOG_LEVEL=debug

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12

SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@byke.com
SEED_ADMIN_MOBILE=9876543210
SEED_ADMIN_PASSWORD=Byke@123

# Photo storage: local disk (dev) or AWS S3 (deployed). For s3 fill in the AWS_* lines.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
