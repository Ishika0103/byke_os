NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/byke_os
# Comma-separated list of allowed origins (Expo web dev server runs on 8081)
CORS_ORIGINS=http://localhost:8081
LOG_LEVEL=debug

# --- Auth (JWT) ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 chars and DIFFERENT from each other. Use new values per environment.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12

# --- First Super Admin (used only by `npm run seed`) ---
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@byke.local
# 8-72 chars, at least one letter and one number
SEED_ADMIN_PASSWORD=

# Where uploaded photos (task proof) are saved. Relative to apps/api.
UPLOAD_DIR=uploads
